// Face box and eye centres via Apple Vision, JSON in pixel coordinates (origin top-left). 17 October 2026
// FR : boîte du visage et centres des yeux en pixels, pour les masques locaux du color grade.
import Foundation
import CoreGraphics
import Vision
import ImageIO
let args = CommandLine.arguments
guard args.count == 3 else { print("usage: Face in.png out.json"); exit(1) }
let url = URL(fileURLWithPath: args[1])
guard let isrc = CGImageSourceCreateWithURL(url as CFURL, nil), let img = CGImageSourceCreateImageAtIndex(isrc, 0, nil) else { exit(3) }
let W = Double(img.width), H = Double(img.height)
let req = VNDetectFaceLandmarksRequest()
try VNImageRequestHandler(cgImage: img, options: [:]).perform([req])
guard let f = req.results?.first else { print("no face"); exit(2) }
let b = f.boundingBox
func px(_ p: CGPoint) -> [Double] { [(b.minX + Double(p.x) * b.width) * W, (1 - (b.minY + Double(p.y) * b.height)) * H] }
func centre(_ r: VNFaceLandmarkRegion2D?) -> [Double] {
    guard let r = r else { return [] }
    let pts = r.normalizedPoints.map(px)
    return [pts.map { $0[0] }.reduce(0, +) / Double(pts.count), pts.map { $0[1] }.reduce(0, +) / Double(pts.count)]
}
let out: [String: Any] = [
  "width": W, "height": H,
  "face": [b.minX * W, (1 - b.maxY) * H, b.width * W, b.height * H],
  "left_eye": centre(f.landmarks?.leftEye), "right_eye": centre(f.landmarks?.rightEye)
]
try JSONSerialization.data(withJSONObject: out, options: .prettyPrinted).write(to: URL(fileURLWithPath: args[2]))
print("ok", out)
