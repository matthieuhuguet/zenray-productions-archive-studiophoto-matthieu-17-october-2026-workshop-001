// Person segmentation mask via Apple Vision. 17 October 2026
// FR : produit un masque PNG 8 bits (blanc = personne) à la taille de l'image source.
import Foundation
import CoreGraphics
import Vision
import CoreImage
import ImageIO
let args = CommandLine.arguments
guard args.count == 3 else { print("usage: Segment in.png out.png"); exit(1) }
let url = URL(fileURLWithPath: args[1])
let req = VNGeneratePersonSegmentationRequest()
req.qualityLevel = .accurate
req.outputPixelFormat = kCVPixelFormatType_OneComponent8
let h = VNImageRequestHandler(url: url, options: [:])
try h.perform([req])
guard let obs = req.results?.first else { print("no result"); exit(2) }
let ci = CIImage(cvPixelBuffer: obs.pixelBuffer)
guard let src = CIImage(contentsOf: url) else { exit(3) }
let sx = src.extent.width / ci.extent.width, sy = src.extent.height / ci.extent.height
let scaled = ci.transformed(by: CGAffineTransform(scaleX: sx, y: sy)).applyingFilter("CILanczosScaleTransform", parameters: [:])
let ctx = CIContext()
let cs = CGColorSpace(name: CGColorSpace.genericGrayGamma2_2)!
try ctx.writePNGRepresentation(of: scaled.cropped(to: src.extent), to: URL(fileURLWithPath: args[2]), format: .L8, colorSpace: cs)
print("ok", src.extent.size)
